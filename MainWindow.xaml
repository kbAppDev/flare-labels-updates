<Window x:Class="FlareLabels.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Flare Tools · Labels" Width="1400" Height="900" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F2F4EE" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" WindowStyle="None" AllowDrop="True" Drop="FileDrop" DragOver="FileDragOver" PreviewKeyDown="Window_KeyDown" Icon="Assets/Flare-Labels.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="AppSurface">
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{StaticResource Shell}"><Grid Margin="18,0,7,0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="Assets/Flare-Labels.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="Flare Tools" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
    <TextBlock Text=" / Labels" Foreground="#C2CBB8" FontSize="13" VerticalAlignment="Center"/>
    <TextBlock x:Name="VersionText" Foreground="#BBC6B0" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 0 0 L 12 0" Stroke="#F0F4EB" StrokeThickness="1.6" Width="12" Height="1"/></Button>
    <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"><Rectangle Width="11" Height="10" Stroke="#F0F4EB" StrokeThickness="1.5"/></Button>
    <Button Style="{StaticResource ChromeButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="#FF9FA3" StrokeThickness="1.7" Width="10" Height="10"/></Button>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Shell}"><Grid Margin="16,24,16,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0">
     <Image Source="Assets/Flare-Labels.png" Width="76" Height="76" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock Text="Labels" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,3"/>
     <TextBlock Text="FLARE FIREPLACES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Lime}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,35,0,0">
     <TextBlock Text="YOUR WORKFLOW" Foreground="#AEBBA2" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,14"/>
     <Button x:Name="ImportStep" Style="{StaticResource RailButton}" Click="Import_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="{StaticResource Lime}" Margin="0,0,12,0"/><TextBlock Text="Import Excel"/></StackPanel></Button>
     <Button x:Name="ReviewStep" Style="{StaticResource RailButton}" Click="Review_Click" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="02" Foreground="{StaticResource Lime}" Margin="0,0,12,0"/><TextBlock Text="Review contacts"/></StackPanel></Button>
     <Button x:Name="ExportStep" Style="{StaticResource RailButton}" Click="Export_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="03" Foreground="{StaticResource Lime}" Margin="0,0,12,0"/><TextBlock Text="Save Word labels"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border Background="#252B21" CornerRadius="20" Padding="16"><StackPanel><TextBlock Text="YOUR LABEL SHEET" Foreground="#B8C5AB" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="4 × 2 inches" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,5"/><TextBlock Text="10 labels · Letter paper" Foreground="#CED8C4" FontSize="11"/><TextBlock Text="Always centered" Foreground="#CED8C4" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
     <Button Content="Print &amp; app settings" Style="{StaticResource RailButton}" FontSize="11" Margin="0,14,0,0" Click="Settings_Click"/>
     <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource RailButton}" FontSize="11" Click="CheckUpdates_Click"/>
     <TextBlock Text="Works offline · Files stay on your PC" TextWrapping="Wrap" Foreground="#B8C5AB" FontSize="10" LineHeight="16" Margin="12,12,8,0"/>
    </StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1">
    <Grid.Background><RadialGradientBrush Center="0.9,0" GradientOrigin="0.9,0" RadiusX="1" RadiusY="1"><GradientStop Color="#E8EFD7"/><GradientStop Color="#F2F4EE" Offset="0.65"/><GradientStop Color="#EFF1EB" Offset="1"/></RadialGradientBrush></Grid.Background>
    <Grid Margin="26,25,26,18">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Mailing, made easy." FontSize="29" FontWeight="SemiBold"/><TextBlock Text="From your spreadsheet to a perfectly centered label." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,12,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import Excel" Click="Import_Click" Margin="0,0,10,0" ToolTip="Import .xlsx, .xlsm or .csv (Ctrl+O)"/><Button x:Name="ExportButton" Content="Save Word labels" Style="{StaticResource Primary}" Click="Export_Click" IsEnabled="False" ToolTip="Create a printable Word document (Ctrl+E)"/></StackPanel>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,23,0,18" Padding="20,15">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock x:Name="FileTitle" Text="Ready for your spreadsheet" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FileDetail" Text="Drop an Excel file anywhere to get started" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><ComboBox x:Name="SheetSelect" Grid.Column="1" Width="145" MinHeight="30" Margin="12,0,0,0" Visibility="Collapsed" SelectionChanged="Sheet_Changed" ToolTip="Worksheet" AutomationProperties.Name="Worksheet"/></Grid>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel MinWidth="62"><TextBlock x:Name="CountImported" Text="0" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Contacts" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
        <Border Background="#E2E6DC" Width="1" Margin="15,2,15,2"/>
        <StackPanel MinWidth="62"><TextBlock x:Name="CountSelected" Text="0" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Selected" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
        <Border Background="#E2E6DC" Width="1" Margin="15,2,15,2"/>
        <StackPanel MinWidth="42"><TextBlock x:Name="CountPages" Text="0" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Sheets" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" MinWidth="390"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><Grid Margin="8">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="12,7,12,12"><TextBlock Text="Your contacts" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/><Button x:Name="MapButton" Content="Match columns" Style="{StaticResource Quiet}" FontSize="11" HorizontalAlignment="Right" Click="Map_Click" IsEnabled="False"/></Grid>
       <Grid Grid.Row="1" Margin="12,0,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="142"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search company, contact or address (Ctrl+F)" AutomationProperties.Name="Search contacts"/><TextBlock x:Name="SearchPlaceholder" Text="Search contacts…" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
        <ComboBox x:Name="FilterSelect" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0" AutomationProperties.Name="Filter contacts"><ComboBoxItem Content="All contacts"/><ComboBoxItem Content="Needs details"/><ComboBoxItem Content="Duplicates"/><ComboBoxItem Content="Selected"/></ComboBox>
       </Grid>
       <Button x:Name="IssueButton" Grid.Row="2" Style="{StaticResource Quiet}" Foreground="{StaticResource Accent}" Background="#FFF0F0" Margin="12,0,12,9" HorizontalContentAlignment="Left" FontSize="11" Click="Issues_Click" Visibility="Collapsed"/>
       <Grid Grid.Row="3">
        <DataGrid x:Name="ContactsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="74" ColumnHeaderHeight="29" Background="Transparent" RowBackground="Transparent" SelectionMode="Single" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Disabled" SelectionChanged="Contact_Selected" MouseDoubleClick="Contact_DoubleClick" PreviewKeyDown="Contacts_KeyDown" EnableRowVirtualization="True">
         <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/></Style>
          <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
          <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="3,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowSurface" Background="Transparent" CornerRadius="14" BorderBrush="Transparent" BorderThickness="1"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#F0F3EA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#EDF5D8"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="#BBCE91"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
         </DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTemplateColumn Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Include,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Include this label" AutomationProperties.Name="{Binding Recipient,StringFormat=Include {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="COMPANY / CONTACT" Width="*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,0,5,0" VerticalAlignment="Center" ToolTip="{Binding Recipient}"><TextBlock Text="{Binding Recipient}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NameDisplay}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="LOCATION / STATUS" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/><TextBlock Text="{Binding Status}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Missing}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4D6422"/><Style.Triggers><DataTrigger Binding="{Binding IsDuplicate}" Value="True"><Setter Property="Foreground" Value="#75550D"/></DataTrigger><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Foreground" Value="#B41C29"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Edit" FontSize="10" Padding="5,5" MinHeight="30" Style="{StaticResource Quiet}" Click="EditRow_Click" ToolTip="Edit this label"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <Border x:Name="EmptyState" Background="#FBFCF9" CornerRadius="18" Margin="6,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" Margin="18">
         <Border Background="#EEF5DC" CornerRadius="23" Width="76" Height="76"><Path Data="M 2 0 L 19 0 L 26 7 L 26 34 L 2 34 Z M 19 0 L 19 7 L 26 7 M 8 15 L 20 15 M 8 22 L 20 22 M 8 28 L 16 28" Stroke="#667F22" StrokeThickness="1.8" Width="26" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock Text="Start with your spreadsheet" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,9"/><TextBlock Text="Drop in Excel. We'll find the address columns and build your labels." TextWrapping="Wrap" TextAlignment="Center" FontSize="13" LineHeight="21" Foreground="{StaticResource Muted}"/>
         <Button Content="Choose Excel file" Click="Import_Click" Style="{StaticResource Primary}" Margin="24,20,24,0"/><Button Content="Explore with sample contacts" Click="Demo_Click" Style="{StaticResource Quiet}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border x:Name="NoResults" Background="#FBFCF9" CornerRadius="18" Margin="6,29,6,0" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock Text="No contacts match" FontSize="17" FontWeight="SemiBold"/><Button Content="Clear search &amp; filters" Style="{StaticResource Quiet}" Click="ClearFilters_Click" Margin="0,12,0,0"/></StackPanel></Border>
       </Grid>
       <Border Grid.Row="4" BorderBrush="#E4E8DE" BorderThickness="0,1,0,0" Padding="5,8,5,3"><DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Left" Content="Select all" Style="{StaticResource Quiet}" Click="SelectAll_Click" FontSize="11" Padding="9,6"/><Button DockPanel.Dock="Left" Content="Clear selection" Style="{StaticResource Quiet}" Click="SelectNone_Click" FontSize="11" Padding="9,6"/>
        <Button x:Name="ReviewDuplicates" DockPanel.Dock="Right" Content="Keep duplicates" Style="{StaticResource Quiet}" Click="KeepDuplicates_Click" FontSize="11" Padding="9,6" Visibility="Collapsed"/>
       </DockPanel></Border>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Background="#DCE3D3"><Grid Margin="18">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><TextBlock Text="Print preview" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="4 × 2 in" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
       <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10,17,10,8"><Border Background="White" Padding="1"><Border.Effect><DropShadowEffect Color="#263019" BlurRadius="22" ShadowDepth="7" Opacity="0.15"/></Border.Effect><Canvas x:Name="SheetCanvas" Width="816" Height="1056" Background="White"/></Border></Viewbox>
       <Grid Grid.Row="2" Margin="0,5,0,12"><Button x:Name="PreviousButton" Padding="12,8" MinHeight="34" HorizontalAlignment="Left" Click="Previous_Click" ToolTip="Previous sheet" AutomationProperties.Name="Previous sheet"><Path Data="M 7 0 L 0 6 L 7 12" Stroke="#38442C" StrokeThickness="1.8" Width="7" Height="12"/></Button><TextBlock x:Name="PageText" Text="Page 1 of 1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button x:Name="NextButton" Padding="12,8" MinHeight="34" HorizontalAlignment="Right" Click="Next_Click" ToolTip="Next sheet" AutomationProperties.Name="Next sheet"><Path Data="M 0 0 L 7 6 L 0 12" Stroke="#38442C" StrokeThickness="1.8" Width="7" Height="12"/></Button></Grid>
       <Border Grid.Row="3" Background="#EFFFFFFF" CornerRadius="18" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Font size" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><ComboBox x:Name="FontSelect" SelectedIndex="3" SelectionChanged="Options_Changed" AutomationProperties.Name="Label font size"><ComboBoxItem Content="10 pt"/><ComboBoxItem Content="12 pt"/><ComboBoxItem Content="14 pt"/><ComboBoxItem Content="16 pt"/><ComboBoxItem Content="18 pt"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Start at label" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><ComboBox x:Name="StartSelect" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Starting label position"><ComboBoxItem Content="1 · new sheet"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox></StackPanel>
       </Grid></Border>
      </Grid></Border>
     </Grid>
     <Grid Grid.Row="3" Margin="3,15,3,0"><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,132,0"/><TextBlock Text="Print at 100% scale" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>